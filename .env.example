# LLM proxy config — read only by api/generate.ts (server-side), never sent to the browser.
# Default: Groq free tier, OpenAI-compatible. Swap to Gemini/another provider by changing these — no code changes needed.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
